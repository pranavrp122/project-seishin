# ─────────────────────────────────────────────
# Project Seishin — Environment Config
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# NVIDIA NIM API key (for Parakeet STT)
# Get from: https://build.nvidia.com/
NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# vLLM — Qwen local server (no key needed, it's local)
VLLM_URL=http://localhost:8000/v1

# Fish Audio — local server (no key needed)
FISH_AUDIO_URL=http://localhost:8080

# Fish Audio voice reference ID
# Create a reference voice in Fish Audio and paste the ID here
# Leave blank to use the default voice
FISH_REFERENCE_ID=

# Dashboard WebSocket port
WS_PORT=8765
