{
  "identifier": "default",
  "description": "Default capabilities for Seishin client",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "websocket:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/whisper-server", "sidecar": true, "args": true }]
    }
  ]
}
