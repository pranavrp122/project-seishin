{
  "identifier": "default",
  "description": "Default capabilities for Seishin client",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "websocket:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "**" }]
    },
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:18789/*" },
        { "url": "http://localhost:18789/*" }
      ]
    },
    "shell:allow-spawn",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/whisper-server", "sidecar": true, "args": true },
        { "name": "wsl", "cmd": "wsl", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "wsl", "cmd": "wsl", "args": true }
      ]
    }
  ]
}
