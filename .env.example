# Seishin Voice Companion -- Environment Variables
# Copy to .env and fill in values. Never commit .env itself.

# --- Sei Engine ---
# SEI_AUTH_TOKEN=<your-websocket-auth-token>
# SEI_BIND=127.0.0.1
# SEI_PORT=5052
# SEI_DEV_MODE=1

# --- LLM (local default: http://127.0.0.1:8000) ---
# SEI_LLM_URL=http://127.0.0.1:8000
# SEI_MODEL_NAME=gemma-4
# SEI_MAX_TOKENS=300
# SEI_TEMPERATURE=0.7

# --- AWS Cloud LLM (Phase 7) ---
# Set these when using cloud Gemma instead of local.
# SEI_LLM_URL=http://<ec2-public-ip>:8000
# SEI_LLM_API_KEY=<64-char-hex-from-openssl-rand>

# AWS GPU instance config (used by scripts/aws/start_gpu.sh and stop_gpu.sh)
# AWS_GPU_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
# AWS_GPU_SG_ID=sg-xxxxxxxxxxxxxxxxx
# AWS_GPU_REGION=us-east-1

# --- TTS (Fish Speech) ---
# SEI_TTS_URL=http://127.0.0.1:8080
# TTS_REFERENCE_ID=archie

# --- ASR ---
# SEI_ASR_URL=http://127.0.0.1:9876

# --- Report API ---
# REPORT_API_URL=http://127.0.0.1:9000
# REPORT_API_KEY=<report-api-key>
